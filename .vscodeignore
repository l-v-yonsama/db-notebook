# This file contains all the files/directories that should
# be ignored (i.e. not included) in the final packaged extension.

# Ignore extension configs
.vscode/**
**/.claude/**

# Ignore test files
.vscode-test/**
out/test/**

# Ignore source code
src/**

# Ignore test code
__tests__/**

# Ignore all webview-ui files except the build directory
webview-ui/src/**
webview-ui/public/**
webview-ui/scripts/**
webview-ui/index.html
webview-ui/README.md
webview-ui/package.json
webview-ui/package-lock.json
webview-ui/node_modules/**

# Ignore Misc
.yarnrc
.DS_Store
vsc-extension-quickstart.md
**/.gitignore
**/tsconfig.json
**/vite.config.ts
**/.eslintrc.json
**/*.map
**/*.ts

# Ignore unused nested archives from sql.js distribution
node_modules/sql.js/dist/*.zip
node_modules/sql.js/dist/sql-asm*.js
node_modules/sql.js/dist/sql-wasm-browser*
node_modules/sql.js/dist/sql-wasm-debug*
node_modules/sql.js/dist/worker.*

misc/**
docs/images/**
