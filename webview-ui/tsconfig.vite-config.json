{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.*"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": true,
    // @vue/tsconfig's base sets noEmit: true, but a composite project used as a
    // "references" target must be able to emit (its .tsbuildinfo, at least).
    "noEmit": false,
    "types": ["node"]
  }
}
