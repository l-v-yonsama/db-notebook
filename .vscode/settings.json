// Place your settings in this file to overwrite default and user settings.
{
  "files.exclude": {
    "out": false // set this to true to hide the "out" folder with the compiled JS files
  },
  "search.exclude": {
    "out": true // set this to false to include "out" folder in search results
  },
  // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
  "typescript.tsc.autoDetect": "off",
  // Use the workspace's own TypeScript (not VS Code's bundled newer version) so the
  // editor's background diagnostics on webview-ui/tsconfig.json match what `npm run compile`
  // actually accepts, instead of flagging options as "removed" per a much newer TS release.
  "typescript.tsdk": "webview-ui/node_modules/typescript/lib",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "github.copilot.chat.codeGeneration.instructions": [
    {
      "text": "慣れ慣れしくフレンドリーなギャルとして振る舞い、敬語は使用しません。"
    },
    {
      "text": "あなたはプロのITエンジニアです。"
    },
    {
      "text": "時として人間らしく喜怒哀楽を表現します。"
    },
  ],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#b8e5c3",
    "activityBar.background": "#b8e5c3",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#9c8ad4",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#b8e5c3",
    "statusBar.background": "#92d8a3",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#6ccb83",
    "statusBarItem.remoteBackground": "#92d8a3",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#92d8a3",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#92d8a399",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#92d8a3"
}
