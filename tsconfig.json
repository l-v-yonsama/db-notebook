{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es6",
    "outDir": "out",
    "lib": ["es6", "dom"],
    "types": ["node", "vscode"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "webview-ui",
    "__tests__",
    "vitest.config.ts",
    "src/notebook/jsLanguageBridge/jsRuntimePrelude.d.ts"
  ]
}
